[Unit]
Description=ExitMesh Telemetry Agent (host mode)
Documentation=https://github.com/cloud-exit/exitmesh-agent/blob/main/docs/install-host.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=|/etc/exitmesh/enrollment-token
ConditionDirectoryNotEmpty=|/var/lib/exitmesh

[Service]
Type=simple
ExecStart=/usr/bin/exitmesh-agent run --config /etc/exitmesh/agent.yaml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
User=exitmesh
Group=exitmesh
SupplementaryGroups=systemd-journal
StateDirectory=exitmesh
StateDirectoryMode=0700
ReadWritePaths=/var/lib/exitmesh
UMask=0077
Environment=GOMEMLIMIT=172MiB
MemoryMax=192M
CPUQuota=10%
LimitNOFILE=65536
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
