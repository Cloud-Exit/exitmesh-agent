{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "exitmesh-agent chart values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^(|https://[^:/?#]+.*)$"
    },
    "endpointCA": {
      "type": "string"
    },
    "enrollment": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^(|emx1_.+)$"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "createNamespaces": {
      "type": "boolean"
    },
    "namespaces": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "coordinator": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "skipLookupValidation": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "coordinator"
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "inventory": {
          "type": "boolean"
        },
        "metrics": {
          "type": "boolean"
        },
        "logs": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "kubernetes": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "cluster",
            "namespaces"
          ]
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labelAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotationAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clusterName": {
          "type": "string"
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        },
        "customResources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxKinds": {
              "type": "integer",
              "minimum": 1
            },
            "maxScopes": {
              "type": "integer",
              "minimum": 1
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "clusterReads": {
          "type": "boolean"
        },
        "issuerDiscovery": {
          "type": "boolean"
        },
        "inventory": {
          "type": "object",
          "properties": {
            "namespaced": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "apiGroups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "apiGroups",
                  "resources"
                ]
              }
            },
            "cluster": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "apiGroups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "apiGroups",
                  "resources"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "generate",
            "certManager",
            "existingSecret"
          ]
        },
        "caBundle": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "validityDays": {
          "type": "integer",
          "minimum": 1
        },
        "certManager": {
          "type": "object",
          "properties": {
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "duration": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
            },
            "renewBefore": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coordinator": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClassName": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            }
          },
          "additionalProperties": false
        },
        "spool": {
          "type": "object",
          "properties": {
            "capacity": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
            },
            "window": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
            },
            "coalesceAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "gid": {
          "type": "integer",
          "minimum": 1
        },
        "runAsRootFallback": {
          "type": "boolean"
        },
        "diskCap": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "evidenceRing": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "scrapeInterval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "maxTargets": {
          "type": "integer",
          "minimum": 1
        },
        "maxSeries": {
          "type": "integer",
          "minimum": 1
        },
        "maxSamplesPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "kubeletTLS": {
          "type": "string",
          "enum": [
            "verify",
            "skip"
          ]
        },
        "kubeletPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "nodeAPI": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "tokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600
        }
      },
      "additionalProperties": false
    },
    "lookback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "prometheus",
              "mimir",
              "victoriametrics",
              "loki",
              "victorialogs"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "tenant": {
            "type": "string"
          },
          "accountID": {
            "type": "string"
          },
          "projectID": {
            "type": "string"
          },
          "timeout": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
          },
          "retention": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
          },
          "bearerToken": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "basicAuth": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "usernameKey": {
                "type": "string"
              },
              "passwordKey": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "ca": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "configMapName": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "egress": {
            "type": "object",
            "properties": {
              "cidrs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
                }
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "url"
        ]
      }
    },
    "airgap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bundles": {
          "type": "object",
          "properties": {
            "configMap": {
              "type": "string"
            },
            "imagePath": {
              "type": "string",
              "pattern": "^(|/.*)$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "exportDir": {
          "type": "string",
          "pattern": "^/data(/.*)?$"
        },
        "persistenceSize": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        },
        "spoolCapacity": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "maxRuleEvalTime": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "maxRuleSamples": {
          "type": "integer",
          "minimum": 1
        },
        "maxRuleSeries": {
          "type": "integer",
          "minimum": 1
        },
        "maxCounterBytes": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "maxEvidenceBytes": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lateThreshold": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "redactionPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "investigation": {
      "type": "object",
      "properties": {
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "maxBytes": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1
        },
        "maxSeries": {
          "type": "integer",
          "minimum": 1
        },
        "maxSamples": {
          "type": "integer",
          "minimum": 1
        },
        "maxWindow": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "properties": {
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "additionalProperties": false
        },
        "apiServer": {
          "type": "object",
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "additionalProperties": false
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "additionalProperties": false
        },
        "kubelet": {
          "type": "object",
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^:\\s]+:[A-Za-z0-9+/]{43}=$"
          }
        },
        "threshold": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}
